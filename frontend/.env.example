# ─── Neon Postgres (https://neon.tech → Project → Dashboard → Connection string) ───
# Pooled connection string — used ONLY by the serverless functions in /api
# (never exposed to the browser). Include ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx.aws.neon.tech/makeinvoice?sslmode=require

# JWT secret for app-level sessions (issued by /api/auth).
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Local dev convenience: return magic / reset links directly in API responses
# instead of emailing them (no email provider wired yet). Defaults to true in
# dev, disabled in production. Set "true" only on a trusted setup.
AUTH_DEV_EXPOSE_LINKS=true

# Public base URL of the app (used for payment return URLs)
VITE_APP_URL=http://localhost:5173
# Server-side alias used by the API (bare APP_URL, no VITE_ prefix).
APP_URL=http://localhost:5173

# ─── SasPay (https://app.saspay.me → Développeur) ─────────────
# API key: sk_test_… (sandbox) or sk_live_… (production).
# NEVER put this in code, git, or the browser.
SASPAY_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret — shown ONCE when you create the webhook in the
# dashboard (Développeur → Webhooks). Format: raw hex/string used as the
# HMAC-SHA256 key. Treat it like the API key.
SASPAY_WEBHOOK_SECRET=your-webhook-signing-secret
