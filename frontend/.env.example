# ─── Neon Postgres (https://neon.tech → Project → Dashboard → Connection string) ───
# Pooled connection string — used ONLY by the serverless functions in /api
# (never exposed to the browser). Include ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx.aws.neon.tech/makeinvoice?sslmode=require

# JWT secret for app-level sessions (issued by /api/auth).
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Local dev convenience: return magic / reset links directly in API responses
# instead of emailing them (no email provider wired). Defaults to true in dev,
# disabled in production. Set "true" only on a trusted setup.
AUTH_DEV_EXPOSE_LINKS=true

# Public base URL of the app (used in payment return URLs)
VITE_APP_URL=http://localhost:5173

# ─── Saspay (hosted checkout, PayDunya-style REST) ─────────
# Keys from your Saspay merchant dashboard. Mode: "test" (sandbox) or "production".
SASPAY_MASTER_KEY=your-saspay-master-key
SASPAY_PRIVATE_KEY=your-saspay-private-key
SASPAY_TOKEN=your-saspay-token
SASPAY_MODE=test
# Optional: override the API base entirely (e.g. if your dashboard uses a
# different host/path). Default: test → https://app.saspay.com/sandbox-api/v1,
# production → https://app.saspay.com/api/v1
# SASPAY_BASE_URL=https://app.saspay.com/sandbox-api/v1
# Optional: absolute URL used for the webhook callback when the frontend and
# backend are on different hosts (e.g. https://your-app.vercel.app). Default:
# derived from VERCEL_URL / VITE_APP_URL.
# BACKEND_URL=https://your-app.vercel.app
